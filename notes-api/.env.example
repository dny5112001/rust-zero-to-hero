APP_HOST=0.0.0.0
APP_PORT=8810
# Matches docker-compose.yml (Postgres on port 5433 so it won't clash with a local one)
DATABASE_URL=postgres://notes:notes@localhost:5433/notes_db
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
RUST_LOG=notes_api=debug,tower_http=info
